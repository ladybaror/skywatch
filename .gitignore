# === קבצי מערכת הפעלה ודפדפנים ===
Thumbs.db
Desktop.ini
.DS_Store

# === הגדרות של סביבות פיתוח (IDEs) ===
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# === קבצי לוגים וזכרון זמני ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# === קבצי תצורה והגדרות של Kubernetes / k3d ===
.kube/
kubeconfig*
*.kubeconfig
.k3d/

# === תעודות אבטחה, מפתחות וסודות (קריטי!) ===
*.pem
*.key
*.pub
.env
.env.local
secrets.yaml

# === קבצי תצורה זמניים של Terraform ===
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# === תיקיות קוד זמניות (אם יש לכם Node.js/Python בפרויקט) ===
node_modules/
__pycache__/
*.pyc
